  <Style Selector="ListBox.referenceList ListBoxItem"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="16,18"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style Selector="ListBox.referenceList ListBoxItem /template/ ContentPresenter"><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource ScLine}"/></Style>
  <Style Selector="ListBox.referenceList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ScSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource ScPrimary}"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style Selector="ListBox.referenceList ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ScQuiet}"/></Style>
  <Style Selector="ListBox.referenceList ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ScSelected}"/></Style>
  <Style Selector="ToggleSwitch"><Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/><Setter Property="MinWidth" Value="42"/><Setter Property="MinHeight" Value="24"/></Style>
  <Style Selector="Border.aiUserBubble"><Setter Property="Background" Value="{DynamicResource ScSelected}"/></Style>
  <Style Selector="Border.aiComposer"><Setter Property="BorderBrush" Value="{DynamicResource ScBorder}"/><Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/></Style>
  <Style Selector="Button.aiSuggestion"><Setter Property="CornerRadius" Value="8"/></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontFamily" Value="{StaticResource ScHeadingFont}"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="ListBox.runList ListBoxItem"><Setter Property="Padding" Value="12,7"/></Style>
  <Style Selector="ScrollBar"><Setter Property="IsVisible" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource ScSidebar}"/></Style>
  <!-- Buttons and headings use Manrope's static semibold and bold faces. -->
  <Style Selector="Button"><Setter Property="FontFamily" Value="{StaticResource ScHeadingFont}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.pill TextBlock"><Setter Property="FontFamily" Value="{StaticResource ScInterfaceFont}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="TextBox"><Setter Property="FontFamily" Value="{StaticResource ScInterfaceFont}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="ComboBox"><Setter Property="FontFamily" Value="{StaticResource ScInterfaceFont}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="SelectableTextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
  <!-- Hidden scrollbars keep wheel, touch, keyboard and programmatic scrolling. -->
  <Style Selector="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Hidden"/><Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/></Style>
  <Style Selector="ListBox"><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/></Style>
  <Style Selector="TextBox"><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/></Style>
  <Style Selector="Border.card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource ScBorderHover}"/><Setter Property="BoxShadow" Value="0 10 24 -16 #303D6370"/></Style>
  <Style Selector="Button.homeRecent"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="Button.homeRecent:pointerover"><Setter Property="Background" Value="{DynamicResource ScQuiet}"/><Setter Property="BorderBrush" Value="{DynamicResource ScBorder}"/></Style>
  <Style Selector="Button.homeRecent:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ScQuiet}"/><Setter Property="BorderBrush" Value="{DynamicResource ScBorder}"/></Style>
  <Style Selector="Button.homeRecent:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ScSelected}"/></Style>
  <!-- Title bar: quick search entry, status chip and keyboard hints. -->
  <Style Selector="Button.titleSearch"><Setter Property="Width" Value="340"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,6,7,6"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Background" Value="{DynamicResource ScQuiet}"/><Setter Property="BorderBrush" Value="{DynamicResource ScLine}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Button.titleSearch:pointerover"><Setter Property="Background" Value="{DynamicResource ScSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ScBorderHover}"/></Style>
  <Style Selector="Button.titleSearch:pointerover icons|LucideIcon.glyph"><Setter Property="Foreground" Value="{DynamicResource ScAccentText}"/></Style>
  <Style Selector="Border.keyHint"><Setter Property="Background" Value="{DynamicResource ScSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ScBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="6,2"/></Style>
  <Style Selector="Border.titleStatus"><Setter Property="Background" Value="{DynamicResource ScQuiet}"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="10,5"/></Style>
 </Application.Styles>
